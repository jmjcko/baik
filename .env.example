# Supabase (Auth and the Universal Rider Passport). Copy this file to .env.local and fill in your project values.
# Both values are public by design (they are sent to the browser); access is protected by row level security.
# NEVER put the service_role key into any variable that starts with NEXT_PUBLIC_ or into the repository.
# Without these two variables the app works as a guest only (data stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gemini (server only, NEVER a NEXT_PUBLIC_ variable). Used by the pre-purchase analysis and by "load my bike from a link" in the wizard.
# Without it both fall back: the analysis to the deterministic report, the link loading to "not available".
GEMINI_API_KEY=your-gemini-key

# Strava (server only, NEVER a NEXT_PUBLIC_ variable). Register the app at https://www.strava.com/settings/api (Authorization Callback Domain: your domain, localhost in development).
# STRAVA_TOKEN_KEY encrypts the tokens before they are stored: 32 random bytes in base64, for example `openssl rand -base64 32`. Without any of the three the Strava card says it is not set up.
STRAVA_CLIENT_ID=…
STRAVA_CLIENT_SECRET=…
STRAVA_TOKEN_KEY=…

# Intervals.icu connection kept in the account (Epic 56, story 56.1), server only, NEVER a NEXT_PUBLIC_ variable.
# INTERVALS_TOKEN_KEY encrypts the key of the rider before it is stored: 32 random bytes in base64, for example `openssl rand -base64 32`.
# Keep a copy in a password manager: when it changes, the stored keys cannot be read any more and the riders connect again.
# Without it the server connection is off and the key stays in the browser (as before).
INTERVALS_TOKEN_KEY=
