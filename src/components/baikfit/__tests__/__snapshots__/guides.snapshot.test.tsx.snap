                    fill="#be185d"
                  />
                </marker>
              </defs>
              <line
                stroke="#be185d"
                stroke-dasharray="6 5"
                stroke-width="2.5"
                x1="240"
                x2="240"
                y1="500"
                y2="230"
              />
