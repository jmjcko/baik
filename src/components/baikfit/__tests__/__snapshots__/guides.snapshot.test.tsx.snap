exports[`measurement guides and step snapshots (en) > should render the saddleHeight guide modal 1`] = `
<DocumentFragment>
  <div
    aria-modal="true"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm animate-fadeIn"
    data-testid="measurement-guide-modal"
    role="dialog"
  >
    <div
      class="bg-white border border-slate-200/90 rounded-2xl shadow-2xl max-w-4xl w-full max-h-[92vh] overflow-y-auto text-slate-900 p-6 md:p-8 space-y-6"
    >
