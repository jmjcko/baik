              x1="18"
              x2="6"
              y1="6"
              y2="18"
            />
            <line
              x1="6"
              x2="18"
              y1="6"
              y2="18"
            />
          </svg>
        </button>
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 items-start"
      >
        <div
          class="bg-slate-50/80 border border-slate-200/90 rounded-2xl p-4 flex flex-col items-center justify-center relative min-h-[380px] overflow-hidden"
        >
