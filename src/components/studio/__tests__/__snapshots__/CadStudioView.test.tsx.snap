      >
        <button
          class="px-3 py-1.5 rounded-lg font-mono text-xs text-slate-300 border border-slate-700 hover:border-slate-500 bg-slate-800/80 transition-colors"
        >
          ← View Diagnostic Report
        </button>
        <button
          class="px-3 py-1.5 rounded-lg font-mono text-xs text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700 bg-slate-950 transition-colors"
        >
          Mode Selection
        </button>
      </div>
    </div>
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start"
    >
      <div
        class="lg:col-span-3 space-y-5"
      >
        <div
          class="rounded-2xl backdrop-blur-sm p-5 bg-slate-900/70 border border-slate-800 shadow-sm "
        >
          <h2
            class="text-sm font-mono uppercase tracking-wider text-slate-400 mb-3"
          >
            Precision Biomechanical Input
          </h2>
          <div
            class="space-y-4"
          >
            <div>
              <div
                class="flex flex-col gap-2"
              >
                <div
                  class="flex items-center justify-between text-sm"
                >
                  <label
                    class="text-slate-300 font-medium tracking-tight"
                    for="inseam-slider"
                  >
                    Inseam Height
                  </label>
                  <span
                    class="mono-chip px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-cyan-400 font-semibold text-xs"
                  >
                    450 mm
                  </span>
                </div>
