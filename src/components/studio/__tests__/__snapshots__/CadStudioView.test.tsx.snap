          class="flex items-center gap-2"
        >
          <span
            class="font-mono text-xs font-bold text-cyan-400 uppercase tracking-wider"
          >
            [CAD STUDIO: PŘÍMÉ DOLADĚNÍ]
          </span>
          <span
            class="mono-chip inline-flex items-center text-xs px-2.5 py-0.5 rounded border uppercase font-medium tracking-wider select-none border-cyan-500/40 text-cyan-400 bg-cyan-950/20 "
          >
            LEMOND 0,883
          </span>
        </div>
        <h1
          class="text-xl font-extrabold text-white"
        >
          bAIkfit Studio
        </h1>
      </div>
      <div
        class="flex items-center gap-2"
      >
