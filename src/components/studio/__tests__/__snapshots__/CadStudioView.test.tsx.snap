exports[`CadStudioView (cs) > should render the studio with active symptoms 1`] = `
<DocumentFragment>
  <div
    class="max-w-7xl mx-auto py-6 px-4 sm:px-6 space-y-6"
  >
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-xl border border-slate-800 bg-slate-900/80 backdrop-blur"
    >
