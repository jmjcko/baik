            >
              <span
                class="text-xs uppercase font-medium text-ink-3 tracking-wider mb-1"
              >
                <span
                  class="relative inline-block group"
                >
                  <button
                    aria-describedby="tip-reach"
                    aria-expanded="false"
                    class="text-left uppercase underline decoration-dotted underline-offset-4 cursor-help"
                    type="button"
                  >
