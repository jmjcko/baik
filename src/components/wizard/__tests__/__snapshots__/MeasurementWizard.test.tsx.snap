            />
            <div
              class="pt-2"
            >
              <button
                class="inline-flex items-center gap-1.5 text-xs font-semibold hover:underline transition-colors py-1 focus:outline-none text-blue-600 hover:text-blue-700"
                data-testid="saddle-guide-trigger"
                type="button"
              >
                <span>
                  Jak změřit výšku sedla na kole?
                </span>
                <span
                  class="font-mono text-xs text-blue-500"
                >
                  ↗
                </span>
              </button>
            </div>
          </div>
          <div
            class="space-y-2"
          >
            <div
              class="flex justify-between items-center"
            >
              <label
                class="text-xs font-mono font-medium text-slate-700"
                for="wizard-bar-slider"
              >
                Šířka tvých řídítek (mm)
              </label>
              <span
                class="font-mono text-sm font-bold text-blue-600"
              >
                nezadáno
              </span>
            </div>
            <input
              class="w-full bg-slate-200 h-2 rounded-lg cursor-pointer accent-blue-600"
              id="wizard-bar-slider"
              max="460"
              min="340"
