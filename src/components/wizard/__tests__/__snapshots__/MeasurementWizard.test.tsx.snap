            <div
              class="pt-2"
            >
              <button
                class="inline-flex items-center gap-1.5 text-xs font-semibold hover:underline transition-colors py-1 focus:outline-none text-blue-600 hover:text-blue-700"
                data-testid="bar-guide-trigger"
                type="button"
              >
                <span>
                  Jak změřit šířku řídítek?
                </span>
                <span
                  class="font-mono text-xs text-blue-500"
                >
                  ↗
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div
        class="flex items-center justify-between pt-8 border-t border-slate-200 mt-8"
      >
        <button
          class="h-12 px-6 rounded-full font-medium text-sm text-slate-600 hover:text-slate-900 border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 transition-colors shadow-sm"
        >
          Zpět
        </button>
        <button
          class="h-12 px-8 rounded-full font-semibold text-sm bg-blue-600 hover:bg-blue-700 text-white transition-all shadow-md active:scale-[0.99] flex items-center justify-center"
        >
          Pokračovat na report posedu →
        </button>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

